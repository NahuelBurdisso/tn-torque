# Postgres — el compose levanta esta base
TNT_DATABASE_URL=postgres://tnt:tnt@localhost:5433/tnt
# Base separada que usan los tests. La borra y recrea en cada corrida.
TNT_TEST_DATABASE_URL=postgres://tnt:tnt@localhost:5433/tnt_test

# Clave maestra: 32 bytes en base64. Generar con:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# SI SE PIERDE, TODOS LOS TOKENS SON IRRECUPERABLES.
TNT_MASTER_KEY=

# App partner TN-Torque (partners.tiendanube.com)
TNT_APP_ID=
TNT_CLIENT_SECRET=
TNT_USER_AGENT=TN-Torque (dev@example.com)

# Tienda demo: la ÚNICA sobre la que los tests pueden escribir
TNT_DEMO_STORE_ID=

# Esta instancia. Debe coincidir con `instance` en cada store.toml
TNT_INSTANCE=torque-pc

# Módulo ntfy
TNT_NTFY_URL=https://ntfy.sh
TNT_NTFY_TOPIC=
